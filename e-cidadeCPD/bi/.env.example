# Copie para bi/.env. Nunca versione o arquivo preenchido.
SUPERSET_PORT=8088
SUPERSET_BIND_ADDRESS=127.0.0.1
SUPERSET_SECRET_KEY=gere-uma-chave-unica-com-openssl-rand-base64-42
SUPERSET_META_DB=superset
SUPERSET_META_USER=superset
SUPERSET_META_PASSWORD=troque-por-uma-senha-forte
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Administrador
SUPERSET_ADMIN_LASTNAME=BI
SUPERSET_ADMIN_EMAIL=bi@example.invalid
SUPERSET_ADMIN_PASSWORD=troque-a-senha-inicial

# Banco operacional: usuário exclusivo, sem escrita, limitado ao schema bi.
# Use o alias da aplicação na rede Docker existente do e-Cidade.
ECIDADE_DB_HOST=ecidade
ECIDADE_DB_PORT=5433
ECIDADE_DB_NAME=ecidade
ECIDADE_BI_USER=ecidade_bi_readonly
ECIDADE_BI_PASSWORD=troque-por-uma-senha-forte

# Origem pública exata do e-Cidade, sem barra final. Usada por frame-ancestors.
ECIDADE_PUBLIC_ORIGIN=http://localhost:5000
