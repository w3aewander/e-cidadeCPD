      <file path="pes1_manutencaosiope.php">

        <operation error="log" label="#1">
          <search>
            <![CDATA[$rh02_anousu = DBPessoal::getAnoFolha();]]>
          </search>
          <add position="replace">
            <![CDATA[
                if (db_getsession("DB_instit") != '96'){                
                    $rh02_anousu = DBPessoal::getAnoFolha();
                } else {
                    $sqlAno = "select fc_anofolha(1) as ano";
                    $rsAno = db_query($sqlAno);
                    db_fieldsmemory($rsAno, 0);
                    $rh02_anousu = $ano;
                }
            ]]>
          </add>
        </operation>

        <operation error="log" label="#2">
          <search>
