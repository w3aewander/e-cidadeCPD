      <file path="func_rhpessoaleducacao.php">

        <operation error="log" label="#1">
          <search>
            <![CDATA[$ano = db_anofolha();]]>
          </search>
          <add position="replace">
            <![CDATA[
                if (db_getsession("DB_instit") != '96'){                
                    $ano = db_anofolha();
                } else {
                    $ano = "fc_anofolha(1)";
                }
            ]]>
          </add>
        </operation>
        
        <operation error="log" label="#2">
